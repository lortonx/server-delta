{
    "compilerOptions": {
        "target": "es2022",
        "module": "node16",
        "moduleResolution": "Node",
        "outDir": "dist",
        "allowSyntheticDefaultImports": true,
        "sourceMap": true,
        "forceConsistentCasingInFileNames": true,
        "strictNullChecks": false,
        "resolveJsonModule": true,
        "allowJs": true,
        "esModuleInterop": true,
    },
    "include": ["./src/**/*.ts", "./**/*.js"]
}

