{
    "compilerOptions": {
        "target": "es2022",
        "module": "node16",
        "moduleResolution": "Node16",
        "outDir": "dist",
        "allowSyntheticDefaultImports": true,
        "sourceMap": true,
        "forceConsistentCasingInFileNames": true,
        "strictNullChecks": false,
        "resolveJsonModule": true,
        "allowJs": true,
        "esModuleInterop": true,
        "strict": false,
        "useDefineForClassFields": false
    },
    "include": ["./src/**/*.ts", "./**/*.js"]
}

