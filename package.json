{
    "name": "parse-server-example",
    "version": "1.4.0",
    "description": "An example Parse API server using the parse-server module",
    "repository": {
        "type": "git",
        "url": "https://github.com/ParsePlatform/parse-server-example"
    },
    "license": "MIT",
    "scripts": {
        "start": "ts-node --experimental-specifier-resolution=node index.ts",
        "devts": "nodemon ./index.ts --inspect=9032",
        "devts2": "nodemon ./src/index.ts --inspect=9032",
        "dev": "set NODE_ENV=dev && nodemon --inspect --experimental-specifier-resolution=node index.js",
        "lint": "eslint --cache ./cloud && eslint --cache index.js && eslint --cache ./spec",
        "lint-fix": "eslint --cache --fix ./cloud && eslint --cache --fix index.js && eslint --cache --fix ./spec",
        "test": "mongodb-runner start && jasmine",
        "coverage": "nyc jasmine",
        "prettier": "prettier --write '{cloud,spec}/{**/*,*}.js' 'index.js'",
        "watch": "babel-watch index.js",
        "tunnel": "ssh -R 80:localhost:1337 nokey@localhost.run"
    },
    "dependencies": {
        "@types/parse": "^3.0.4",
        "@typescript-eslint/eslint-plugin": "^6.6.0",
        "@typescript-eslint/parser": "^6.6.0",
        "axios": "^0.27.2",
        "cors": "^2.8.5",
        "crypto-js": "^4.1.1",
        "dotenv": "^16.0.0",
        "eslint": "^8.48.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "express": "4.17.1",
        "googleapis": "^100.0.0",
        "graphql-tag": "^2.12.6",
        "module-alias": "^2.2.3",
        "moment": "^2.29.4",
        "node-fetch": "*",
        "nodemon": "^3.0.1",
        "overshom-wayforpay": "^1.1.0",
        "parse-dashboard": "^5.0.0",
        "parse-server": "^6.2.2",
        "tinyduration": "^3.3.0",
        "tough-cookie": "^4.0.0",
        "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.15.0"
    },
    "engines": {
        "node": ">=12.22.10 <19"
    },
    "peerDependencies": {
        "node-fetch": "*"
    },
    "peerDependenciesMeta": {
        "node-fetch": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/cors": "^2.8.14",
        "@types/react": "^18.2.21",
        "@types/react-dom": "^18.2.7",
        "babel-eslint": "10.1.0",
        "babel-watch": "7.4.0",
        "jasmine": "3.6.4",
        "mongodb-runner": "4.8.1",
        "prettier": "3.0.3",
        "ts-node": "^10.9.2",
        "typescript": "^5.2.2",
        "webpack": "^5.88.2",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^4.15.1"
    }
}
